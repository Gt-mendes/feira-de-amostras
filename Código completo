  #DECLARAÇÃO DAS FUNÇÕES
  
  def mostrar_evento(self):
    # EXIBE AS PERGUNTAS TROCANDO DE ACORDO COM A FUNÇÃO (PRÓXIMO EVENTO)
    evento = self.eventos[self.evento_atual]

    self.label_titulo_pergunta.text = evento["titulo"]
    self.label_pergunta.text = evento["história"]
    self.btn_resposta1.text = evento["opcaoA"]
    self.btn_resposta2.text = evento["opcaoB"]

  def atualizar_indicadores(self):
    #ATUALIZA OS INDICADORES DOS ATRIBUTOS
    self.lb_popularidade.text = f"👑 Popularidade do Rei: {self.popularidade}%"
    self.lb_tesouro.text = f"💰 Tesouro real: {self.tesouro}%"
    self.lb_exercito.text = f"⚔️ Exército: {self.exercito}%"
    self.lb_recursos.text = f"🌾 Recursos: {self.recursos}%"

  def limitar_atributos(self):
    #LIMITA OS ATRIBUTOS PARA NÃO PASSAREM DE 100% NEM FICAREM ABAIXO DE 0
    self.popularidade = max(0, min(100, self.popularidade))

    self.tesouro = max(0, min(100, self.tesouro))

    self.exercito = max(0, min(100, self.exercito))

    self.recursos = max(0, min(100, self.recursos))
    
  def proximo_evento(self):
    #FUNCIONA EM PARALELO COM A FUNÇÃO (MOSTRAR EVENTO) PARA IR PRO PRÓXIMO DICIONÁRIO COM AS PERGUNTAS E ALTERAÇÕES. E ENVIA PRA TELA FINAL
    self.evento_atual +=1

    if self.evento_atual >= len(self.eventos):

      open_form('tela_final')

    else:

      self.mostrar_evento()

  def mostrar_consequencias(self, efeito):
    #EXIBE UMA LABEL COM OS VALORES QUE FORAM ALTERADOS NA ÚLTIMA ESCOLHA
    mensagem = "📜 Consequências da última decisão: "

    if efeito["popularidade"] != 0:
      mensagem += f"  👑 {efeito['popularidade']:+}"

    if efeito["tesouro"] != 0:
      mensagem += f"  💰 {efeito['tesouro']:+}"

    if efeito["exercito"] != 0:
      mensagem += f"  ⚔️ {efeito['exercito']:+}"

    if efeito["recursos"] != 0:
      mensagem += f"  🌾 {efeito['recursos']:+}"

      self.label_consequencias.text = mensagem

  @handle("btn_resposta1", "click")
  def btn_resposta1_click(self, **event_args):
    #ALTERA OS VALORES SE O USUÁRIO ESCOLHER A PRIMEIRA OPÇÃO
    evento = self.eventos[self.evento_atual]

    efeito = evento["efeitoA"]

    self.popularidade += efeito["popularidade"]

    self.tesouro += efeito["tesouro"]

    self.exercito += efeito["exercito"]

    self.recursos += efeito["recursos"]

    self.limitar_atributos()

    self.mostrar_consequencias(efeito)
    
    self.atualizar_indicadores()

    self.proximo_evento()

